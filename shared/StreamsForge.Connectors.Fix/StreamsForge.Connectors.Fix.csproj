<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The FIX session engine, and NOTHING else — see FixInboundTransport's class doc for why
         QuickFIXn.Core is a dependency of this project alone; StreamsForge.AppCore gains nothing. -->
    <PackageReference Include="QuickFIXn.Core" Version="1.14.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runtime-agnostic by construction: Contracts + AppCore only, exactly what
         StreamsForge.Connectors.Database references. No Orleans, no Dapr, no ASP.NET — both hosts
         reference this one project (wave D). -->
    <ProjectReference Include="..\StreamsForge.AppCore\StreamsForge.AppCore.csproj" />
    <ProjectReference Include="..\StreamsForge.Contracts\StreamsForge.Contracts.csproj" />
  </ItemGroup>
</Project>
