<Project>
  <!--
    Orleans' source generator (running downstream, in StreamForge.Abstractions, via
    [assembly: Orleans.GenerateCodeForDeclaringAssembly] — see AssemblyInfo.cs there) needs the full
    implementation assembly for this project, not the metadata-only "reference assembly" the .NET SDK
    produces by default for project-to-project references (ORLEANS0110: "[GenerateSerializer] used in
    a reference assembly" — the generator can't reliably introspect a ref assembly for codegen
    purposes). Scoped to this project only (Directory.Build.props stops climbing once found, and no
    project lives below this directory), so it does not affect any other project's build.
  -->
  <PropertyGroup>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>
</Project>
