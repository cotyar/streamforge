<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StreamForge.Abstractions</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Attribute types only ([GenerateSerializer]/[Id]) — no Orleans runtime/codegen. -->
    <PackageReference Include="Microsoft.Orleans.Serialization.Abstractions" Version="10.2.1" />
    <!-- Orleans.Sdk.targets injects this implicitly on the Orleans side; Models.cs relies on it. -->
    <Using Include="Orleans" />
  </ItemGroup>
</Project>
