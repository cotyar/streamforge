<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Plan 025 G1: Grpc.AspNetCore / Grpc.Reflection moved to shared/StreamsForge.Api along with
         Grpc/** and Protos/**, so both flavors serve the identical gRPC surface; this host reaches them
         transitively through that project reference and adds nothing of its own. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.3.0" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\StreamsForge.Engine\StreamsForge.Engine.csproj" />
    <ProjectReference Include="..\..\..\shared\StreamsForge.Contracts\StreamsForge.Contracts.csproj" />
    <ProjectReference Include="..\..\..\shared\StreamsForge.AppCore\StreamsForge.AppCore.csproj" />
    <ProjectReference Include="..\..\..\shared\StreamsForge.Api\StreamsForge.Api.csproj" />
    <ProjectReference Include="..\..\..\shared\StreamsForge.Connectors.Database\StreamsForge.Connectors.Database.csproj" />
    <ProjectReference Include="..\StreamsForge.Abstractions\StreamsForge.Abstractions.csproj" />
    <!-- Quant, Fix and Crdt are now install-time server plugins (plugins/), not host references — see
         StreamsForgePlugins.LoadFrom in Program.cs. ReferenceOutputAssembly=false: build order only,
         nothing from these projects is linked into the host. The targets below copy each plugin's
         single merged DLL into $(OutDir)plugins\ so `dotnet run`/F5 still has the quant functions, the
         `fix` kinds and the `crdt` kind without an operator installing anything by hand. -->
    <ProjectReference Include="..\..\..\plugins\StreamsForge.Plugins.Quant\StreamsForge.Plugins.Quant.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\plugins\StreamsForge.Plugins.Fix\StreamsForge.Plugins.Fix.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\plugins\StreamsForge.Plugins.Crdt\StreamsForge.Plugins.Crdt.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyBuiltInPlugins" AfterTargets="Build">
    <ItemGroup>
      <_BuiltInPluginDlls Include="..\..\..\plugins\StreamsForge.Plugins.Quant\bin\$(Configuration)\net10.0\merged\StreamsForge.Plugins.Quant.dll" />
      <_BuiltInPluginDlls Include="..\..\..\plugins\StreamsForge.Plugins.Fix\bin\$(Configuration)\net10.0\merged\StreamsForge.Plugins.Fix.dll" />
      <_BuiltInPluginDlls Include="..\..\..\plugins\StreamsForge.Plugins.Crdt\bin\$(Configuration)\net10.0\merged\StreamsForge.Plugins.Crdt.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_BuiltInPluginDlls)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
  </Target>
  <!-- Same DLLs into the publish output, so `dotnet publish` (tools/publish.sh, the Dockerfiles) ships
       the built-in plugins next to the single-file exe without any script copying them by hand. -->
  <Target Name="PublishBuiltInPlugins" AfterTargets="Publish" DependsOnTargets="CopyBuiltInPlugins">
    <Copy SourceFiles="@(_BuiltInPluginDlls)" DestinationFolder="$(PublishDir)plugins" SkipUnchangedFiles="true" />
  </Target>
  <!-- Plan 025 G1: the <Protobuf> items moved to shared/StreamsForge.Api with the .proto files. The
       generated types keep their csharp_namespace (StreamsForge.Host.Grpc.V1), so nothing that compiles
       against them — this host, the tests, clients/dotnet — changed. -->
  <!-- Single-file publish settings live next door, so publish knobs never mix with references. -->
  <Import Project="Publish.props" Condition="Exists('Publish.props')" />
</Project>
