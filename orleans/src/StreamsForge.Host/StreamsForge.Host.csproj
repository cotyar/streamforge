<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.Reflection" Version="2.83.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.3.0" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\StreamsForge.Engine\StreamsForge.Engine.csproj" />
    <ProjectReference Include="..\..\..\shared\StreamsForge.Contracts\StreamsForge.Contracts.csproj" />
    <ProjectReference Include="..\..\..\shared\StreamsForge.AppCore\StreamsForge.AppCore.csproj" />
    <ProjectReference Include="..\..\..\shared\StreamsForge.Api\StreamsForge.Api.csproj" />
    <ProjectReference Include="..\..\..\shared\StreamsForge.Connectors.Database\StreamsForge.Connectors.Database.csproj" />
    <ProjectReference Include="..\..\..\shared\StreamsForge.Connectors.Fix\StreamsForge.Connectors.Fix.csproj" />
    <!-- Plan 020 wave B-2: CrdtDocGrain calls CrdtProjector.Flatten/Diff directly, the same
         "out-of-core connector project" shape StreamsForge.Connectors.Database/Fix already have here. -->
    <ProjectReference Include="..\..\..\shared\StreamsForge.Connectors.Crdt\StreamsForge.Connectors.Crdt.csproj" />
    <ProjectReference Include="..\..\..\shared\StreamsForge.Quant\StreamsForge.Quant.csproj" />
    <ProjectReference Include="..\StreamsForge.Abstractions\StreamsForge.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\streamsforge.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\streamsforge_dynamic.proto" GrpcServices="Server" />
  </ItemGroup>
  <!-- Single-file publish settings live next door, so publish knobs never mix with references. -->
  <Import Project="Publish.props" Condition="Exists('Publish.props')" />
</Project>
