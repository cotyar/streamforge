        {
          "row": {
            "desk": "Rates",
            "exposure_usd": 100.0
          },
          "weight": 1
        }
      ],
      "liveBatches": [
        {
          "deltas": [
            {
              "row": {
                "desk": "Rates",
                "exposure_usd": 100.0
              },
              "weight": -1
            },
            {
              "row": {
                "desk": "Rates",
                "exposure_usd": 250.0
              },
              "weight": 1
            }
          ],
          "seq": 1
        }
      ],
      "expectedRows": [
