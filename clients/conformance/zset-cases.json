{
  "version": 1,
  "cases": [
    {
      "name": "assert-only",
      "description": "Two independent asserts, no snapshot, no supersession.",
      "keyFields": [
        "desk"
      ],
      "bufferedBatches": [],
      "snapshot": [],
      "liveBatches": [
        {
          "deltas": [
            {
              "row": {
                "desk": "Rates",
                "exposure_usd": 100.0
              },
              "weight": 1
            },
            {
              "row": {
                "desk": "Credit",
                "exposure_usd": 40.0
              },
              "weight": 1
            }
          ],
          "seq": 1
        }
      ],
      "expectedRows": [
        {
          "desk": "Rates",
          "exposure_usd": 100.0
        },
        {
          "desk": "Credit",
          "exposure_usd": 40.0
        }
      ]
    },
    {
      "name": "retract-then-assert",
