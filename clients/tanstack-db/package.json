{
  "name": "@streamforge/tanstack-db",
  "version": "0.1.0",
  "description": "TanStack DB collection backed by a StreamForge live table.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "bun run --cwd ../typescript build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@streamforge/client": ">=0.1.0",
    "@tanstack/db": ">=0.1.0"
  },
  "devDependencies": {
    "@streamforge/client": "workspace:*",
    "@tanstack/db": "^0.1.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.0"
  }
}
